local STRATEGIC_TICK_MS = 10000

local initialized = false
local next_tick_at = 0

local function log(message)
    printf("[Zone Frontier] %s", message)
end

function init()
    if initialized then
        return
    end

    local state = zf_state and zf_state.init()

    if state ~= nil then
        if zf_resources then
            zf_resources.init_state(state)
        end

        if zf_factions then
            zf_factions.init_state(state)
        end

        if zf_territories then
            zf_territories.init_state(state)
        end

        if zf_caravans then
            zf_caravans.init_state(state)
        end
    end

    next_tick_at = time_global() + STRATEGIC_TICK_MS
    initialized = true

    if zf_state and state ~= nil then
        log(
            "core initialized factions="
            .. tostring(zf_state.count_map_items(state.factions))
            .. " territories="
            .. tostring(zf_state.count_map_items(state.territories))
        )
    else
        log("core initialized")
    end
end

local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end

    if value > maximum then
        return maximum
    end

    return value
end

local function add_resource(storage, resource_id, amount)
    storage[resource_id] = (storage[resource_id] or 0) + amount
end

local function consume_resource(storage, resource_id, amount)
    local current = storage[resource_id] or 0
    local consumed = math.min(current, amount)
    storage[resource_id] = current - consumed
    return consumed
end

local function update_territory(territory)
    local shortage = 0

    for resource_id, amount in pairs(territory.production or {}) do
        add_resource(territory.storage, resource_id, amount)
    end

    for resource_id, amount in pairs(territory.consumption or {}) do
        local consumed = consume_resource(territory.storage, resource_id, amount)
        if consumed < amount then
            shortage = shortage + (amount - consumed)
        end
    end

    if shortage > 0 then
        territory.supply = clamp(territory.supply - 0.08 * shortage, 0, 1)
    else
        territory.supply = clamp(territory.supply + 0.02, 0, 1)
    end

    if territory.supply < 0.35 then
        territory.security = clamp(territory.security - 0.03, 0, 1)
    elseif territory.supply > 0.75 then
        territory.security = clamp(territory.security + 0.01, 0, 1)
    end
end

local function update_economy(state)
    for _, territory in pairs(state.territories or {}) do
        update_territory(territory)
    end
end

local function resource_amount(territory, resource_id)
    if territory == nil or territory.storage == nil then
        return 0
    end

    return territory.storage[resource_id] or 0
end

local function log_tick_summary(state)
    local rv = state.territories.rookie_village
    local cp = state.territories.cordon_checkpoint
    local gh = state.territories.garbage_hangar

    log(
        "tick="
        .. tostring(state.strategic_tick)
        .. " rv_food="
        .. tostring(resource_amount(rv, "food"))
        .. " cp_food="
        .. tostring(resource_amount(cp, "food"))
        .. " cp_ammo="
        .. tostring(resource_amount(cp, "ammo_basic"))
        .. " gh_scrap="
        .. tostring(resource_amount(gh, "scrap_metal"))
        .. " caravans="
        .. tostring(zf_state and zf_state.active_caravan_count(state) or 0)
        .. " last_event="
        .. tostring(state.last_event)
    )
end

function update()
    if not initialized then
        init()
    end

    local now = time_global()
    if now < next_tick_at then
        return
    end

    next_tick_at = now + STRATEGIC_TICK_MS

    if zf_state then
        zf_state.increment_tick()
        local state = zf_state.get()

        update_economy(state)

        if zf_caravans then
            zf_caravans.update(state)
        end

        log_tick_summary(state)
    end
end

function reset_debug_state()
    if zf_state then
        zf_state.reset_debug_state()
    end

    next_tick_at = time_global() + STRATEGIC_TICK_MS
    log("debug state reset")
end
