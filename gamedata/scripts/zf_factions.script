local definitions = {
    loners = {
        id = "loners",
        display_name = "Loners",
        base_aggression = 0.25,
        expansion_preference = 0.35,
    },
    bandits = {
        id = "bandits",
        display_name = "Bandits",
        base_aggression = 0.70,
        expansion_preference = 0.60,
    },
}

local function copy_faction(definition)
    return {
        id = definition.id,
        display_name = definition.display_name,
        influence = 0,
        territories = {},
        resources = {},
        manpower = {
            rookies = 0,
            regulars = 0,
            veterans = 0,
            specialists = 0,
        },
        relations = {},
    }
end

function get_definitions()
    return definitions
end

function init_state(state)
    state.faction_definitions = definitions

    for id, definition in pairs(definitions) do
        if state.factions[id] == nil then
            state.factions[id] = copy_faction(definition)
        end
    end
end

