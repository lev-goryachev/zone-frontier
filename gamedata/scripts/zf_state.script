local world_state = nil

function init()
    if world_state == nil then
        local sim_core = zf_sim_core or (require and require("zf_sim_core"))
        local sim_state = zf_sim_state or (require and require("zf_sim_state"))

        if sim_core and sim_core.new_world then
            world_state = sim_core.new_world()
        elseif sim_state and sim_state.new_world_state then
            world_state = sim_state.new_world_state()
        else
            world_state = {
                schema_version = "0.1.0",
                initialized = true,
                strategic_tick = 0,
                territories = {},
                factions = {},
                caravans = {},
                events = {},
                supply_routes = {},
                resource_definitions = {},
                faction_definitions = {},
                territory_definitions = {},
                last_event = "none",
                next_caravan_id = 1,
            }
        end
    end

    return world_state
end

function get()
    return init()
end

function reset_debug_state()
    world_state = nil
    return world_state
end

function count_map_items(value)
    local sim_state = zf_sim_state or (require and require("zf_sim_state"))

    if sim_state and sim_state.count_map_items then
        return sim_state.count_map_items(value)
    end

    return 0
end

function active_caravan_count(state)
    local sim_state = zf_sim_state or (require and require("zf_sim_state"))

    if sim_state and sim_state.active_caravan_count then
        return sim_state.active_caravan_count(state or get())
    end

    return 0
end
