local MOD_NAME = "Zone Frontier"
local LOG_PREFIX = "[" .. MOD_NAME .. "]"

local first_update_done = false

local function log(message)
    printf("%s %s", LOG_PREFIX, message)
end

local function actor_on_first_update()
    if first_update_done then
        return
    end

    first_update_done = true
    log("actor_on_first_update reached")

    if zf_debug_hud then
        zf_debug_hud.on_actor_ready()
        zf_debug_hud.update()
    end

    if UnregisterScriptCallback then
        UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
    end
end

local function actor_on_update()
    if zf_debug_hud then
        zf_debug_hud.update()
    end
end

local function actor_on_net_destroy()
    if zf_debug_hud then
        zf_debug_hud.hide()
    end
end

local function on_option_change()
    if zf_debug_hud then
        zf_debug_hud.update(true)
    end
end

local function on_gui_show()
    if zf_debug_hud then
        zf_debug_hud.set_gui_open(true)
    end
end

local function on_gui_hide()
    if zf_debug_hud then
        zf_debug_hud.set_gui_open(false)
    end
end

function on_game_start()
    log("zf_main loaded")

    if RegisterScriptCallback then
        RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
        RegisterScriptCallback("actor_on_update", actor_on_update)
        RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
        RegisterScriptCallback("actor_on_before_death", actor_on_net_destroy)
        RegisterScriptCallback("on_option_change", on_option_change)
        RegisterScriptCallback("GUI_on_show", on_gui_show)
        RegisterScriptCallback("GUI_on_hide", on_gui_hide)
    end
end
