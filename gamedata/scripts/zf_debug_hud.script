local UPDATE_INTERVAL_MS = 250
local WIDTH = 360
local HEIGHT = 230
local POS_X = 18
local POS_Y = 118

local hud = nil
local actor_ready = false
local gui_open = false
local last_update = 0
local update_count = 0

local function is_enabled()
    return zf_mcm and zf_mcm.get_config("debug_enabled") == true
end

local function safe_value(fn, fallback)
    local ok, value = pcall(fn)
    if ok and value ~= nil then
        return value
    end

    return fallback
end

local function current_level()
    return safe_value(function()
        return level.name()
    end, "unknown")
end

local function actor_status()
    return db and db.actor and "ready" or "missing"
end

local function count(value)
    if zf_state and zf_state.count_map_items then
        return zf_state.count_map_items(value)
    end

    return 0
end

local function world_state()
    if zf_state and zf_state.get then
        return zf_state.get()
    end

    return nil
end

local function build_text()
    update_count = update_count + 1
    local state = world_state()

    if state == nil then
        return string.format(
            "Zone Frontier\nloaded: yes\nactor: %s\nlevel: %s\nhud_tick: %d\nstate: missing",
            actor_status(),
            current_level(),
            update_count
        )
    end

    local rv = state.territories.rookie_village or {}
    local cp = state.territories.cordon_checkpoint or {}
    local gh = state.territories.garbage_hangar or {}
    local cp_storage = cp.storage or {}
    local gh_storage = gh.storage or {}

    return string.format(
        "Zone Frontier\nactor: %s\nlevel: %s\nschema: %s\nstrategic_tick: %d\nterritories: %d factions: %d\ncaravans: %d active: %d\nevents: %d\nrv supply/security: %.2f/%.2f\ncp food/ammo: %d/%d\ngh scrap: %d\nlast: %s",
        actor_status(),
        current_level(),
        tostring(state.schema_version),
        tonumber(state.strategic_tick) or 0,
        count(state.territories),
        count(state.factions),
        count(state.caravans),
        zf_state and zf_state.active_caravan_count(state) or 0,
        count(state.events),
        tonumber(rv.supply) or 0,
        tonumber(rv.security) or 0,
        tonumber(cp_storage.food) or 0,
        tonumber(cp_storage.ammo_basic) or 0,
        tonumber(gh_storage.scrap_metal) or 0,
        tostring(state.last_event)
    )
end

class "ZoneFrontierDebugHUD" (CUIScriptWnd)

function ZoneFrontierDebugHUD:__init() super()
    self:SetAutoDelete(true)
    self:SetWndPos(vector2():set(POS_X, POS_Y))
    self:SetWndSize(vector2():set(WIDTH, HEIGHT))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_zf_debug.xml")

    self.shadow = xml:InitStatic("line", self)
    self.shadow:SetWndPos(vector2():set(1, 1))
    self.shadow:SetWndSize(vector2():set(WIDTH, HEIGHT))
    self.shadow:TextControl():SetTextColor(GetARGB(210, 0, 0, 0))
    self.shadow:TextControl():SetTextComplexMode(true)

    self.text = xml:InitStatic("line", self)
    self.text:SetWndPos(vector2():set(0, 0))
    self.text:SetWndSize(vector2():set(WIDTH, HEIGHT))
    self.text:TextControl():SetTextColor(GetARGB(230, 180, 220, 180))
    self.text:TextControl():SetTextComplexMode(true)

    self:Refresh()
end

function ZoneFrontierDebugHUD:__finalize()
end

function ZoneFrontierDebugHUD:Refresh()
    local text = build_text():gsub("\n", "\\n")
    self.shadow:TextControl():SetText(text)
    self.text:TextControl():SetText(text)
end

function show()
    if hud ~= nil then
        return
    end

    hud = ZoneFrontierDebugHUD()
    get_hud():AddDialogToRender(hud)
end

function hide()
    if hud == nil then
        return
    end

    get_hud():RemoveDialogToRender(hud)
    hud = nil
end

function on_actor_ready()
    actor_ready = true
end

function set_gui_open(value)
    gui_open = value == true

    if hud ~= nil then
        hud:Show(not gui_open)
    end
end

function update(force)
    if not actor_ready then
        return
    end

    if not is_enabled() then
        hide()
        return
    end

    show()

    if hud ~= nil then
        hud:Show(not gui_open)
    end

    local now = time_global()
    if (not force) and now < last_update + UPDATE_INTERVAL_MS then
        return
    end

    last_update = now

    if hud ~= nil then
        hud:Refresh()
    end
end
